// Dream Home Online - Database Schema
// =====================================================
// This schema is committed with the datasource provider STATICALLY set to
// "postgresql" - the production target (Render managed PostgreSQL). This file
// is the single source of truth and is NEVER mutated by scripts; the production
// build (`prisma generate && next build`) and `prisma migrate deploy` use it
// directly, reading the connection from the DATABASE_URL environment variable.
//
// Local development derives a SQLite copy at `prisma/schema.dev.prisma` via
// `scripts/prisma-dev-schema.mjs` (gitignored), used only by the `db:*` scripts
// prefixed with `node scripts/prisma-dev-schema.mjs`. It never touches this
// file, the GitHub repo, or the PostgreSQL deployment.
//
// We use String fields (instead of DB enums) because SQLite does not support
// enums and string columns map 1:1 to TEXT on PostgreSQL. Data integrity is
// enforced at the application layer with TypeScript union types and server-side
// validation.
// =====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== MODELS =====
model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  emailVerified   DateTime?
  password        String?
  phone           String?
  avatar          String?
  role            String   @default("USER") // USER | AGENT | ADMIN
  bio             String?
  isAgentApproved Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  properties        Property[] @relation("AgentProperties")
  favorites         Favorite[]
  inquiriesMade     Inquiry[] @relation("Inquirer")
  inquiriesForAgent Inquiry[] @relation("AgentInquiries")
  viewingsRequested Viewing[] @relation("ViewingRequester")
  viewingsForAgent  Viewing[] @relation("AgentViewings")
  notifications     Notification[]
  passwordTokens    PasswordResetToken[]

  @@index([role])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Property {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  price        Int
  listingType  String // SALE | RENT
  propertyType String // HOUSE | APARTMENT | CONDO | VILLA | TOWNHOUSE | OFFICE | LAND | COMMERCIAL
  address      String
  city         String
  state        String
  country      String
  latitude     Float?
  longitude    Float?
  bedrooms     Int
  bathrooms    Int
  area         Int
  yearBuilt    Int?
  furnished    Boolean  @default(false)
  parking      Int      @default(0)
  status       String   @default("PENDING") // PENDING | ACTIVE | REJECTED | SOLD | RENTED | ARCHIVED
  featured     Boolean  @default(false)
  featuredAt   DateTime?
  viewCount    Int      @default(0)
  agentId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agent       User             @relation("AgentProperties", fields: [agentId], references: [id], onDelete: Cascade)
  images      PropertyImage[]
  amenities   PropertyAmenity[]
  favorites   Favorite[]
  inquiries   Inquiry[]
  viewings    Viewing[]
  reports     Report[]

  @@index([city])
  @@index([state])
  @@index([listingType])
  @@index([propertyType])
  @@index([price])
  @@index([status])
  @@index([agentId])
  @@index([featured])
  @@index([city, listingType, status])
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  publicId   String?
  propertyId String
  sortOrder  Int      @default(0)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

model Amenity {
  id         String             @id @default(cuid())
  name       String             @unique
  properties PropertyAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@map("property_amenities")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model Inquiry {
  id         String   @id @default(cuid())
  userId     String?
  propertyId String
  agentId    String
  name       String
  email      String
  phone      String?
  message    String
  status     String   @default("NEW") // NEW | READ | REPLIED | CLOSED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User?    @relation("Inquirer", fields: [userId], references: [id], onDelete: SetNull)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agent    User     @relation("AgentInquiries", fields: [agentId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([agentId])
  @@index([status])
  @@index([createdAt])
}

model Viewing {
  id         String   @id @default(cuid())
  userId     String?
  propertyId String
  agentId    String
  date       DateTime
  time       String
  notes      String?
  status     String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | COMPLETED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User?    @relation("ViewingRequester", fields: [userId], references: [id], onDelete: SetNull)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agent    User     @relation("AgentViewings", fields: [agentId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([agentId])
  @@index([userId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String?
  type      String   @default("INFO") // INFO | SUCCESS | WARNING | ERROR
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model Report {
  id         String   @id @default(cuid())
  propertyId String
  reporterId String?
  reason     String
  details    String?
  status     String   @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([status])
  @@map("reports")
}
