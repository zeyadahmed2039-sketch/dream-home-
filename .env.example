# ===== DREAM HOME ONLINE .env.example =====
# Copy this file to .env and fill in your real values.
# NEVER commit real secrets to version control.

# --- Database ---
# Local development (SQLite, zero setup): prisma/schema.prisma is committed
# with provider "postgresql"; the dev-only `db:*` scripts derive a SQLite copy
# (prisma/schema.dev.prisma) automatically.
DATABASE_URL="file:./dev.db"
# Production (Render PostgreSQL):
#   Render injects DATABASE_URL automatically from the linked Postgres instance
#   (Internal URL, e.g. postgres://dreamhome_user:****@dpg-xxxx-a.oregon-postgres.render.com:5432/dreamhome_xxxx)
#   The committed schema provider is "postgresql"; production uses `npm run
#   db:deploy` (prisma migrate deploy) to apply migrations safely.
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public"

# --- NextAuth ---
# Canonical NextAuth v4 secret variable (read by src/lib/auth.ts). REQUIRED in
# production. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Required by NextAuth in production: must be your live URL (no trailing slash).
NEXTAUTH_URL=""

# --- Google OAuth (optional - skip to disable Google sign-in) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- App ---
# In production this must be your live URL (no trailing slash):
# e.g. https://dream-home.onrender.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Storage ---
# Storage driver: "local" (dev) or "cloudinary" (production, REQUIRED on Render
# because Render's filesystem is ephemeral).
STORAGE_DRIVER="local"

# Cloudinary credentials (only needed if STORAGE_DRIVER="cloudinary")
# Create at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""