# ===== DREAM HOME ONLINE .env.example =====
# Copy this file to .env and fill in your real values.
# NEVER commit real secrets to version control.

# --- Database ---
# Local development (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Production (Render PostgreSQL):
#   Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
#   With Render: paste the "Internal Database URL" from your Render Postgres
#   instance with the password filled in, e.g.:
#   postgresql://dreamhome_user:REPLACE_ME@dpg-xxxx-a.oregon-postgres.render.com:5432/dreamhome_xxxx?schema=public
#   The schema.prisma provider is set to "postgresql" for production builds.
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
# Render: set AUTH_SECRET to a long random string.
AUTH_SECRET=""
NEXTAUTH_URL=""
NEXTAUTH_URL_INTERNAL=""

# --- Google OAuth (optional - skip to disable Google sign-in) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- App ---
# In production this must be your live URL (no trailing slash):
# e.g. https://dream-home.onrender.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Storage ---
# Storage driver: "local" (dev) or "cloudinary" (production, REQUIRED on Render
# because Render's filesystem is ephemeral).
STORAGE_DRIVER="local"

# Cloudinary credentials (only needed if STORAGE_DRIVER="cloudinary")
# Create at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""